<?xml version="1.0" encoding="utf-8"?>
<!-- cassette: Your computer, from Settings (iPhone MacDeviceView, e080d4c0, 88355575).
     Three of the newest records fanned out, "YOUR COMPUTER", its name, its state in
     one word, "1,204 ALBUMS · 13,880 SONGS"; a card: how much of it is on this phone,
     Syncs (read only: it is the account's), Last synced, Resync Library; then NEW IN
     YOUR LIBRARY *lately*, each record playing in one tap. Never "Mac". No hairlines. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cs_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/computer_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="?attr/actionBarSize"
            android:paddingBottom="@dimen/global_padding_bottom">

            <!-- the fan: three covers, the middle one lifted -->
            <FrameLayout
                android:id="@+id/computer_fan"
                android:layout_width="match_parent"
                android:layout_height="194dp"
                android:clipChildren="false"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/computer_fan_left"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center_horizontal|bottom"
                    android:elevation="10dp"
                    android:scaleType="centerCrop"
                    android:translationX="-104dp"
                    app:shapeAppearanceOverlay="@style/CassetteArtworkTile" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/computer_fan_right"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center_horizontal|bottom"
                    android:elevation="10dp"
                    android:scaleType="centerCrop"
                    android:translationX="104dp"
                    app:shapeAppearanceOverlay="@style/CassetteArtworkTile" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/computer_fan_middle"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="14dp"
                    android:elevation="14dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/CassetteArtworkTile" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="22dp"
                android:paddingEnd="22dp">

                <TextView
                    android:id="@+id/computer_kicker"
                    style="@style/Cassette.Role.Kicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:text="@string/cassette_your_computer"
                    android:textAllCaps="true"
                    android:textColor="@color/cs_ink2"
                    app:drawableStartCompat="@drawable/ic_lucide_laptop"
                    app:drawableTint="@color/cs_ink2" />

                <TextView
                    android:id="@+id/computer_name"
                    style="@style/Cassette.Role.HeroName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="2"
                    tools:text="Studio iMac" />

                <TextView
                    android:id="@+id/computer_state"
                    style="@style/Cassette.Role.Answer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:visibility="gone"
                    tools:text="in sync"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/computer_meta"
                    style="@style/Cassette.Role.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    tools:text="1,204 ALBUMS · 13,880 SONGS" />
            </LinearLayout>

            <!-- the card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/cs_card"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/computer_coverage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/computer_coverage_line"
                        style="@style/Cassette.Role.TileLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        tools:text="160 of 163 albums on this phone" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/computer_coverage_meter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:max="1000"
                        app:indicatorColor="@color/cs_ink"
                        app:trackColor="@color/cs_hairline"
                        app:trackCornerRadius="3dp"
                        app:trackThickness="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/computer_syncs_row"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/Cassette.Role.TileLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/cassette_syncs"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/computer_syncs"
                        style="@style/LabelCardSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Everything" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/computer_synced_row"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/Cassette.Role.TileLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/cassette_last_synced"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/computer_synced"
                        style="@style/LabelCardSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="22 min ago" />
                </LinearLayout>

                <TextView
                    android:id="@+id/computer_resync"
                    style="@style/Cassette.Role.TileLabel"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/cassette_resync"
                    android:textSize="17sp" />
            </LinearLayout>

            <!-- NEW IN YOUR LIBRARY lately -->
            <LinearLayout
                android:id="@+id/computer_new"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/computer_new_heading"
                    style="@style/Cassette.Role.Shout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingTop="28dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="12dp"
                    tools:text="NEW IN YOUR LIBRARY lately" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/computer_new_records"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/computer_bar_backdrop"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="top"
        android:alpha="0"
        android:background="@color/cs_bg" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/computer_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:titleTextAppearance="@style/Cassette.Text.BarTitle" />
</FrameLayout>
