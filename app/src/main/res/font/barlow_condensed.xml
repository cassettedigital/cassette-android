<?xml version="1.0" encoding="utf-8"?>
<!-- cassette: the display face. Same four weights the iOS app bundles, copied
     from apps/cassette-player-ios/amperfy/Amperfy/Resources/Fonts so the two
     platforms are literally rendering the same files. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/barlow_condensed_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/barlow_condensed_semibold"
        android:fontStyle="normal"
        android:fontWeight="600" />
    <font
        android:font="@font/barlow_condensed_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
    <font
        android:font="@font/barlow_condensed_extrabold"
        android:fontStyle="normal"
        android:fontWeight="800" />
</font-family>
