<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme.SplashScreen" parent="Theme.SplashScreen">
        <!-- cassette: open on our own dark, not a flat black that belongs to
             nothing. Matches the app background the splash hands off to. -->
        <item name="windowSplashScreenBackground">@color/cs_dark_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ui_splash_screen</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
        <item name="windowSplashScreenAnimationDuration">100</item>
    </style>

    <!-- cassette: one theme for light and dark (DayNight). Every colour is a
         kit role from values/colors.xml (light) or values-night/colors.xml
         (dark), so the app follows the phone's light or dark the way the iPhone
         does (Settings > Appearance: Auto, Light, Dark).

         Primary is INK, not orange: buttons, switches, text buttons and dialog
         keys are ink on the paper (cream in dark, espresso in light), the
         iPhone's rule that orange marks only live state. Orange is cs_accent,
         used by name where something is live (progress, what's playing). -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cs_fill</item>
        <item name="colorOnPrimary">@color/cs_on_fill</item>
        <item name="colorPrimaryContainer">@color/cs_elevated</item>
        <item name="colorOnPrimaryContainer">@color/cs_ink</item>
        <item name="colorSecondary">@color/cs_ink2</item>
        <item name="colorOnSecondary">@color/cs_bg</item>
        <item name="colorSecondaryContainer">@color/cs_elevated</item>
        <item name="colorOnSecondaryContainer">@color/cs_ink</item>
        <item name="colorTertiary">@color/cs_accent</item>
        <item name="colorOnTertiary">@color/cs_on_fill</item>
        <item name="colorTertiaryContainer">@color/cs_elevated</item>
        <item name="colorOnTertiaryContainer">@color/cs_ink</item>
        <item name="colorError">@color/cs_danger</item>
        <item name="colorErrorContainer">@color/cs_elevated</item>
        <item name="colorOnError">@color/cs_on_fill</item>
        <item name="colorOnErrorContainer">@color/cs_ink</item>
        <item name="android:colorBackground">@color/cs_bg</item>
        <item name="colorOnBackground">@color/cs_ink</item>
        <item name="colorSurface">@color/cs_bg</item>
        <item name="colorOnSurface">@color/cs_ink</item>
        <item name="colorSurfaceVariant">@color/cs_elevated</item>
        <item name="colorOnSurfaceVariant">@color/cs_ink2</item>
        <item name="colorSurfaceDim">@color/cs_sunken</item>
        <item name="colorSurfaceBright">@color/cs_elevated</item>
        <item name="colorSurfaceContainerLowest">@color/cs_sunken</item>
        <item name="colorSurfaceContainerLow">@color/cs_raised</item>
        <item name="colorSurfaceContainer">@color/cs_raised</item>
        <item name="colorSurfaceContainerHigh">@color/cs_elevated</item>
        <item name="colorSurfaceContainerHighest">@color/cs_elevated</item>
        <item name="colorOutline">@color/cs_hairline</item>
        <item name="colorOutlineVariant">@color/cs_hairline</item>
        <item name="colorOnSurfaceInverse">@color/cs_bg</item>
        <item name="colorSurfaceInverse">@color/cs_ink</item>
        <item name="colorPrimaryInverse">@color/cs_bg</item>
        <!-- Material tints elevated surfaces with primary; ours are flat roles. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="elevationOverlayColor">@color/cs_elevated</item>

        <item name="android:windowLightStatusBar">@bool/cs_light_paper</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/cs_light_paper</item>
        <item name="android:statusBarColor">@color/cs_bg</item>
        <item name="android:navigationBarColor">@color/cs_raised</item>
        <item name="android:scrollbars">none</item>

        <!-- the brand faces reach Material's own components too -->
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="fontFamily">@font/barlow_condensed</item>
        <item name="textAppearanceTitleLarge">@style/Cassette.Text.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/Cassette.Text.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/Cassette.Text.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/Cassette.Text.BodyMedium</item>
        <item name="textAppearanceLabelLarge">@style/Cassette.Text.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/Cassette.Text.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/Cassette.Text.LabelSmall</item>

        <!-- keep the window out of Android 15's forced edge-to-edge -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>

        <item name="popupMenuStyle">@style/Cassette.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Cassette.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Cassette.PopupMenu.Overflow</item>
        <item name="materialAlertDialogTheme">@style/Cassette.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/Cassette.BottomSheet</item>
        <item name="materialButtonStyle">@style/Cassette.Button</item>
    </style>


    <!-- cassette: sheets, menus and dialogs on flat role surfaces. -->
    <style name="Cassette.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorSurface">@color/cs_raised</item>
        <item name="colorSurfaceContainerLow">@color/cs_raised</item>
        <item name="shapeAppearanceOverlay">@style/Cassette.Shape.BottomSheet</item>
    </style>

    <style name="Cassette.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/cs_menu_background</item>
    </style>

    <style name="Cassette.PopupMenu.Overflow" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/cs_menu_background</item>
    </style>

    <style name="Cassette.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/cs_elevated</item>
        <item name="colorSurfaceContainerHigh">@color/cs_elevated</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <!-- Material re-tints popup backgrounds with primary in code; wrapping the
         popup's context here makes that tint the neutral surface itself. -->
    <style name="Cassette.NeutralTintContext" parent="">
        <item name="colorPrimary">@color/cs_elevated</item>
        <item name="elevationOverlayColor">@color/cs_elevated</item>
    </style>


    <!-- cassette: the two pills that head every record page (iPhone 4b0bbde8,
         kit component.pill): a cream PLAY (PAUSE while that page plays) and a
         ghost SHUFFLE ring, both 48dp capsules in Barlow Bold capitals. -->
    <style name="Cassette.Pill" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:textAppearance">@style/Cassette.Role.Pill</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
        <item name="shapeAppearanceOverlay">@style/Cassette.Shape.Button</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Cassette.Pill.Play">
        <item name="backgroundTint">@color/cs_fill</item>
        <item name="android:textColor">@color/cs_on_fill</item>
        <item name="iconTint">@color/cs_on_fill</item>
        <item name="icon">@drawable/cs_play_glyph</item>
    </style>
    <style name="Cassette.Pill.Shuffle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:textAppearance">@style/Cassette.Role.Pill</item>
        <item name="android:textColor">@color/cs_ink</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/cs_ink</item>
        <item name="icon">@drawable/ic_lucide_shuffle</item>
        <item name="strokeColor">@color/cs_pill_ring</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="shapeAppearanceOverlay">@style/Cassette.Shape.Button</item>
    </style>

    <!-- cassette: perfect circle for the big album-page play button -->
    <style name="CassetteCircleFab">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- cassette: album/cover art with softly rounded corners (iOS reference). -->
    <style name="CassetteRoundedCover">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">7dp</item>
    </style>

    <!-- cassette: circular artist face on the artist page (iOS GenericDetail header). -->
    <style name="CassetteCircleCover">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- cassette: cross-device skin overlays — applied at activity creation from
         the account's theme_id (Cassette dynamic color; wallpaper gets no vote).
         Classic is a no-op (the base theme IS classic orange). -->
    <style name="CassetteSkin" />
    <style name="CassetteSkin.Amber">
        <item name="colorPrimary">@color/cs_skin_amber_accent</item>
        <item name="colorOnPrimary">@color/cs_skin_ink</item>
    </style>
    <style name="CassetteSkin.Rust">
        <item name="colorPrimary">@color/cs_skin_rust_accent</item>
        <item name="colorOnPrimary">@color/cs_skin_ink</item>
    </style>
    <style name="CassetteSkin.Marine">
        <item name="colorPrimary">@color/cs_skin_marine_accent</item>
        <item name="colorOnPrimary">@color/cs_skin_ink</item>
    </style>
    <style name="CassetteSkin.Lime">
        <item name="colorPrimary">@color/cs_skin_lime_accent</item>
        <item name="colorOnPrimary">@color/cs_skin_ink</item>
    </style>
    <style name="CassetteSkin.Violet">
        <item name="colorPrimary">@color/cs_skin_violet_accent</item>
        <item name="colorOnPrimary">@color/cs_skin_ink</item>
    </style>
    <style name="CassetteSkin.Rose">
        <item name="colorPrimary">@color/cs_skin_rose_accent</item>
        <item name="colorOnPrimary">@color/cs_skin_ink</item>
    </style>

    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:background">@color/dividerColor</item>
    </style>

    <style name="NoConnectionTextView">
        <item name="background">?attr/colorErrorContainer</item>
        <item name="android:textColor">?attr/colorOnErrorContainer</item>
    </style>

    <!-- cassette: unused since 2026-11-09. The tab bar keeps Android's own
         selected-tab pill (founder call: Android's conventions for the frame). -->
    <style name="Cassette.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
        <item name="android:color">@android:color/transparent</item>
        <item name="marginHorizontal">0dp</item>
    </style>

    <style name="Cassette.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearanceOverlay">@style/Cassette.Shape.Button</item>
    </style>

    <style name="Cassette.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="shapeAppearanceOverlay">@style/Cassette.Shape.Button</item>
    </style>

    <style name="Cassette.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="shapeAppearanceOverlay">@style/Cassette.Shape.Button</item>
    </style>

    <!-- parent="" is required: a dotted name otherwise implies a Cassette.Shape
         parent that does not exist, and AAPT fails linking. -->
    <style name="Cassette.Shape.Button" parent="">
        <!-- round everywhere (design-system decision, 2026-10-29): anything you
             press is a capsule, as on the iPhone and the web. -->
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- cassette: sheet corners at iOS's 15pt, down from Material's 28dp. -->
    <style name="Cassette.Shape.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">15dp</item>
        <item name="cornerSizeTopRight">15dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>

