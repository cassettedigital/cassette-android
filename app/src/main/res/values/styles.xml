<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.SplashScreen" parent="Theme.SplashScreen">
        <!-- cassette: open on our own dark, not a flat black that belongs to
             nothing. Matches the app background the splash hands off to. -->
        <item name="windowSplashScreenBackground">@color/md_theme_dark_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ui_splash_screen</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
        <item name="windowSplashScreenAnimationDuration">100</item>
    </style>

    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_light_onTertiaryContainer</item>
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorErrorContainer">@color/md_theme_light_errorContainer</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <item name="colorOnErrorContainer">@color/md_theme_light_onErrorContainer</item>
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_light_outline</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_light_inverseOnSurface</item>
        <item name="colorSurfaceInverse">@color/md_theme_light_inverseSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_light_primaryInverse</item>

        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:scrollbars">none</item>

        <!-- cassette: see the note in values-night/styles.xml - declared here
             rather than in a values-v35 fork of the entire theme. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <!-- cassette: perfect circle for the big album-page play button -->
    <style name="CassetteCircleFab">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- cassette: album/cover art with softly rounded corners (iOS reference). -->
    <style name="CassetteRoundedCover">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">7dp</item>
    </style>

    <!-- cassette: circular artist face on the artist page (iOS GenericDetail header). -->
    <style name="CassetteCircleCover">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- cassette: cross-device skin overlays — applied at activity creation from
         the account's theme_id (Cassette dynamic color; wallpaper gets no vote).
         Classic is a no-op (the base theme IS classic orange). -->
    <style name="CassetteSkin" />
    <style name="CassetteSkin.Amber">
        <item name="colorPrimary">@color/cs_skin_amber_accent</item>
        <item name="colorOnPrimary">@color/cs_skin_ink</item>
    </style>
    <style name="CassetteSkin.Rust">
        <item name="colorPrimary">@color/cs_skin_rust_accent</item>
        <item name="colorOnPrimary">@color/cs_skin_ink</item>
    </style>
    <style name="CassetteSkin.Marine">
        <item name="colorPrimary">@color/cs_skin_marine_accent</item>
        <item name="colorOnPrimary">@color/cs_skin_ink</item>
    </style>
    <style name="CassetteSkin.Lime">
        <item name="colorPrimary">@color/cs_skin_lime_accent</item>
        <item name="colorOnPrimary">@color/cs_skin_ink</item>
    </style>
    <style name="CassetteSkin.Violet">
        <item name="colorPrimary">@color/cs_skin_violet_accent</item>
        <item name="colorOnPrimary">@color/cs_skin_ink</item>
    </style>
    <style name="CassetteSkin.Rose">
        <item name="colorPrimary">@color/cs_skin_rose_accent</item>
        <item name="colorOnPrimary">@color/cs_skin_ink</item>
    </style>

    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:background">@color/dividerColor</item>
    </style>

    <style name="NoConnectionTextView">
        <item name="background">?attr/colorErrorContainer</item>
        <item name="android:textColor">?attr/colorOnErrorContainer</item>
    </style>

    <!-- cassette: no active-indicator pill in the tab bar. Material draws a
         colorSecondaryContainer capsule behind the selected icon; iOS marks the
         selected tab with ink alone. Zero-size and transparent removes it
         without fighting the component's own layout. -->
    <style name="Cassette.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
        <item name="android:color">@android:color/transparent</item>
        <item name="marginHorizontal">0dp</item>
    </style>

    <!-- cassette: buttons are a soft rectangle (iOS BasicButton, 10pt), not
         Material's fully-rounded pill. The pill is the single most "stock
         Android" shape in the app and appears wherever a filled button does. -->
    <style name="Cassette.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearanceOverlay">@style/Cassette.Shape.Button</item>
    </style>

    <style name="Cassette.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="shapeAppearanceOverlay">@style/Cassette.Shape.Button</item>
    </style>

    <style name="Cassette.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="shapeAppearanceOverlay">@style/Cassette.Shape.Button</item>
    </style>

    <!-- parent="" is required: a dotted name otherwise implies a Cassette.Shape
         parent that does not exist, and AAPT fails linking. -->
    <style name="Cassette.Shape.Button" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <!-- cassette: sheet corners at iOS's 15pt, down from Material's 28dp. -->
    <style name="Cassette.Shape.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">15dp</item>
        <item name="cornerSizeTopRight">15dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>

