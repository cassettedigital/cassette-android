<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- cassette: no search icon in the bar. Search is a tab of its own, so
         the icon was a second door to the same room, and iOS does not carry
         one here either. The action id is kept below in the overflow so the
         handler and any deep link still resolve. -->
    <item
        android:id="@+id/action_search"
        android:icon="@drawable/ic_search"
        android:title="@string/menu_search_button"
        app:showAsAction="never" />

    <!-- cassette: Cast lives in the overflow, not the bar. iOS keeps the top
         bar to profile + screen name; a standalone cast icon was the only thing
         breaking that. MediaRouteActionProvider still works from the overflow. -->
    <item
        android:id="@+id/media_route_menu_item"
        android:title="@string/media_route_menu_title"
        app:actionProviderClass="androidx.mediarouter.app.MediaRouteActionProvider"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_settings"
        android:icon="@drawable/ic_settings"
        android:title="@string/menu_settings_button"
        app:showAsAction="never" />
</menu>