<?xml version="1.0" encoding="utf-8"?>
<!-- cassette: flat de-saturated menu/popup surface. Replaces Material's
     tonally-tinted popup background (colorSurface blended with the orange
     primary) so menus render warm-grey, not brown. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/md_theme_dark_surfaceContainerHigh" />
    <corners android:radius="12dp" />
</shape>
