<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/md_theme_dark_primary</item>
        <item name="colorOnPrimary">@color/md_theme_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_dark_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_dark_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_dark_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_dark_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_dark_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_dark_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_dark_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_dark_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_dark_onTertiaryContainer</item>
        <item name="colorError">@color/md_theme_dark_error</item>
        <item name="colorErrorContainer">@color/md_theme_dark_errorContainer</item>
        <item name="colorOnError">@color/md_theme_dark_onError</item>
        <item name="colorOnErrorContainer">@color/md_theme_dark_onErrorContainer</item>
        <item name="android:colorBackground">@color/md_theme_dark_background</item>
        <item name="colorOnBackground">@color/md_theme_dark_onBackground</item>
        <item name="colorSurface">@color/md_theme_dark_surface</item>
        <item name="colorOnSurface">@color/md_theme_dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_dark_onSurfaceVariant</item>
        <!-- cassette: tonal-surface family — see colors.xml note. Without these,
             filled cards / bottom nav fall back to Material's baseline grays. -->
        <item name="colorSurfaceDim">@color/md_theme_dark_surfaceDim</item>
        <item name="colorSurfaceBright">@color/md_theme_dark_surfaceBright</item>
        <item name="colorSurfaceContainerLowest">@color/md_theme_dark_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_dark_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/md_theme_dark_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_dark_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_dark_surfaceContainerHighest</item>
        <item name="colorOutline">@color/md_theme_dark_outline</item>
        <!-- cassette: THE systemic off-switch for the brown. Material's View
             system has no settable colorSurfaceTint (that's Compose-only); the
             real lever is elevationOverlayEnabled. Off = elevated surfaces stop
             compositing the orange tint and render flat at their token colour,
             everywhere at once (menus, dialogs, sheets). elevationOverlayColor
             is the fallback tint for any path that still overlays. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="elevationOverlayColor">@color/md_theme_dark_surfaceContainerHighest</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_dark_inverseOnSurface</item>
        <item name="colorSurfaceInverse">@color/md_theme_dark_inverseSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_dark_primaryInverse</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:scrollbars">none</item>

        <!-- cassette: keep the window out of Android 15's forced edge-to-edge.
             This used to live in a values-night-v35 copy of the WHOLE theme,
             which meant every Android 15+ device silently got a fork of the
             theme frozen before the tonal-tint sweep - the brown came back on
             exactly the newest phones and nowhere else, which is why it kept
             looking fixed. One attribute is not worth a second copy of the
             theme; it is declared here and the -v35 files are gone. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>

        <!-- cassette: neutralize the remaining tint channels — popup menus, the
             overflow menu, and dialogs all paint a colorPrimary-tinted surface
             that reads brown. Point them at a flat de-saturated background. -->
        <item name="popupMenuStyle">@style/Cassette.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Cassette.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Cassette.PopupMenu.Overflow</item>
        <item name="materialAlertDialogTheme">@style/Cassette.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/Cassette.BottomSheet</item>
    </style>

    <!-- cassette: the ⋯ bottom sheets tint their surface with the primary too.
         Neutralize the primary for the sheet context so the blend is grey. These
         sheets are text + neutral icons (no orange accents), so nothing visible
         is lost. -->
    <style name="Cassette.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorPrimary">@color/md_theme_dark_surfaceContainerHighest</item>
        <item name="elevationOverlayColor">@color/md_theme_dark_surfaceContainerHighest</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="Cassette.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/cs_menu_background</item>
    </style>

    <style name="Cassette.PopupMenu.Overflow" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/cs_menu_background</item>
    </style>

    <style name="Cassette.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/md_theme_dark_surfaceContainerHigh</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <!-- cassette: Material 3 re-tints popup backgrounds in CODE (a primary-blended
         MaterialShapeDrawable), ignoring android:popupBackground. The only lever
         that reaches it is what it tints WITH — so wrap the popup's context in this
         overlay where colorPrimary IS the neutral surface. Result: surface blended
         with neutral = neutral. Menu text (colorOnSurface) is untouched. -->
    <style name="Cassette.NeutralTintContext" parent="">
        <item name="colorPrimary">@color/md_theme_dark_surfaceContainerHighest</item>
        <item name="elevationOverlayColor">@color/md_theme_dark_surfaceContainerHighest</item>
    </style>

    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:background">@color/dividerColor</item>
    </style>

    <style name="NoConnectionTextView">
        <item name="background">?attr/colorError</item>
        <item name="android:textColor">?attr/colorOnError</item>
    </style>
</resources>