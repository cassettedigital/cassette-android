<?xml version="1.0" encoding="utf-8"?>
<!-- cassette: a station's page (iPhone RadioStationVC, 535f7b63, 9e68a3bf). Its
     picture lit like a record page, the NAME, "Network · City", PLAY (STOP while
     on) and SAVE; ON AIR: the show, the song on now, what came before ("12 min
     ago") and what's next; then MORE LIKE *station*. Read every 30 seconds while
     the page is up. No hairlines. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cs_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/station_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/global_padding_bottom">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.cappielloantonio.tempo.ui.view.CoverGlowView
                    android:id="@+id/station_glow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="?attr/actionBarSize"
                    android:paddingEnd="22dp"
                    android:paddingBottom="8dp">

                    <FrameLayout
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:elevation="14dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/station_art"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/CassetteStationShape" />

                        <TextView
                            android:id="@+id/station_word_art"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/barlow_condensed"
                            android:gravity="center"
                            android:maxLines="3"
                            android:padding="16dp"
                            android:textAllCaps="true"
                            android:textColor="#FFF3EADB"
                            android:textFontWeight="800"
                            android:textSize="34sp"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/station_name"
                        style="@style/Cassette.Role.PageTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:breakStrategy="balanced"
                        android:maxLines="3"
                        android:textAllCaps="true"
                        tools:text="KEXP" />

                    <TextView
                        android:id="@+id/station_kicker"
                        style="@style/Cassette.Role.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        tools:text="SEATTLE · LIVE" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/station_play"
                            style="@style/Cassette.Pill.Play"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:text="@string/cassette_play" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/station_save"
                            style="@style/Cassette.Pill.Shuffle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:text="@string/cassette_save" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- ON AIR -->
            <LinearLayout
                android:id="@+id/station_on_air"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/Cassette.Role.Shout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingTop="28dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="8dp"
                    android:text="@string/cassette_on_air"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:id="@+id/station_show"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="10dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/station_show_image"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="12dp"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/CassetteArtworkRow" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/station_show_name"
                            style="@style/Cassette.Role.TileLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            tools:text="The Morning Show" />

                        <TextView
                            android:id="@+id/station_show_when"
                            style="@style/LabelCardSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="Until 10:00 AM, then Midday" />
                    </LinearLayout>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/station_plays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/station_next"
                    style="@style/LabelCardSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="20dp"
                    android:visibility="gone"
                    tools:text="Next: Midday at 10:00 AM" />
            </LinearLayout>

            <!-- MORE LIKE station -->
            <LinearLayout
                android:id="@+id/station_similar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/station_similar_heading"
                    style="@style/Cassette.Role.Shout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingTop="28dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="12dp"
                    tools:text="MORE LIKE KEXP" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/station_similar_tiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/station_bar_backdrop"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="top"
        android:alpha="0"
        android:background="@color/cs_bg" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/station_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:titleTextAppearance="@style/Cassette.Text.BarTitle" />
</FrameLayout>
