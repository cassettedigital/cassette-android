<?xml version="1.0" encoding="utf-8"?>
<!-- cassette: Add a note, from inside the share sheet (CassetteShareSong). The song, when it
     starts (only offered for the song playing), the note, and Send, which brings the share
     sheet back with the same link. The buttons name their shape: inside a sheet the theme's
     shape is the sheet's own (Cassette.Shape.BottomSheet, square at the bottom). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cs_bottom_sheet_bg"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/share_note_cover_image_view"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/share_note_title_text_view"
                style="@style/LabelMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true" />

            <TextView
                android:id="@+id/share_note_artist_text_view"
                style="@style/LabelCardSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/share_note_start_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:checkedButton="@id/share_note_from_start_button"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/share_note_from_start_button"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:shapeAppearanceOverlay="@style/Cassette.Shape.Button"
            android:text="@string/share_song_from_start" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/share_note_from_here_button"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:shapeAppearanceOverlay="@style/Cassette.Shape.Button" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/share_note_input_layout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColorHint="?android:textColorHint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/share_note_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/share_song_add_note"
            android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
            android:maxLines="10"
            android:minLines="4" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/share_note_send_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="52dp"
        app:shapeAppearanceOverlay="@style/Cassette.Shape.Button"
        android:text="@string/share_song_send" />
</LinearLayout>
