<?xml version="1.0" encoding="utf-8"?>
<!-- cassette: one genre's page. Its name big in caps, "14 ALBUMS · 162 SONGS",
     PLAY and SHUFFLE pills over every song of it on this phone, then its
     records in the Library's grid. Only what is on this phone. No hairlines. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cs_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/genre_page_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="?attr/actionBarSize"
            android:paddingBottom="@dimen/global_padding_bottom">

            <LinearLayout
                android:id="@+id/genre_page_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/kit_tile_gutter"
                android:paddingTop="8dp"
                android:paddingEnd="@dimen/kit_tile_gutter"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/genre_page_title"
                    style="@style/Cassette.Role.PageTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:breakStrategy="balanced"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textAllCaps="true"
                    tools:text="INDIE ROCK" />

                <TextView
                    android:id="@+id/genre_page_meta"
                    style="@style/Cassette.Role.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    tools:text="14 ALBUMS · 162 SONGS" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/genre_page_play"
                        style="@style/Cassette.Pill.Play"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:text="@string/cassette_play" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/genre_page_shuffle"
                        style="@style/Cassette.Pill.Shuffle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="@string/cassette_shuffle" />
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/genre_page_albums"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingStart="@dimen/kit_tile_gutter"
                android:paddingTop="20dp"
                android:paddingEnd="@dimen/kit_tile_gutter" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/genre_page_bar_backdrop"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="top"
        android:alpha="0"
        android:background="@color/cs_bg" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/genre_page_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:titleTextAppearance="@style/Cassette.Text.BarTitle" />
</FrameLayout>
