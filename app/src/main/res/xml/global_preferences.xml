<?xml version="1.0" encoding="utf-8"?>
<!-- cassette: settings rebuilt to iOS's shape. iOS is a short root of focused
     screens (Account / Playback / App Icon / Storage · Support / About /
     Advanced), each tiny. Android had ~40 controls in one flat scroll across 8
     categories (Transcoding, Replay Gain, Rating, Scrobble, Share, Syncing…),
     almost all Tempo residue or things the account and sensible defaults own.
     What remains: four drill-in screens matching iOS. Removed keys keep working
     from their defaults (e.g. scrobbling stays on) - they are just no longer
     surfaced as controls. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceScreen
        app:key="screen_account"
        app:title="@string/settings_screen_account">

        <!-- Per-app display language. Kept: it overrides the app's UI language
             independent of the phone's system language (Tempo ships several). -->
        <ListPreference
            app:defaultValue="default"
            app:dialogTitle="@string/settings_language"
            app:key="language"
            app:title="@string/settings_language" />

        <Preference
            android:key="logout"
            android:title="@string/settings_logout_title" />
    </PreferenceScreen>

    <PreferenceScreen
        app:key="screen_playback"
        app:title="@string/settings_screen_playback">

        <Preference
            android:key="equalizer"
            android:summary="@string/settings_equalizer_summary"
            android:title="@string/settings_equalizer_title" />
    </PreferenceScreen>

    <PreferenceScreen
        app:key="screen_storage"
        app:title="@string/settings_screen_storage">

        <ListPreference
            app:defaultValue="256"
            app:dialogTitle="@string/settings_streaming_cache_size"
            app:entries="@array/streaming_cache_size_titles"
            app:entryValues="@array/streaming_cache_size_values"
            app:key="streaming_cache_size"
            app:title="@string/settings_streaming_cache_size" />

        <Preference
            android:key="streaming_cache_storage"
            app:title="@string/settings_streaming_cache_storage_title" />

        <Preference
            android:key="download_storage"
            app:title="@string/settings_download_storage_title" />

        <Preference
            android:key="delete_download_storage"
            app:summary="@string/settings_delete_download_storage_summary"
            app:title="@string/settings_delete_download_storage_title" />
    </PreferenceScreen>

    <PreferenceScreen
        app:key="screen_about"
        app:title="@string/settings_about_title">

        <Preference
            android:key="version"
            app:title="@string/settings_version_title" />

        <Preference
            android:key="report_problem"
            app:summary="@string/settings_report_problem_summary"
            app:title="@string/settings_report_problem_title" />
    </PreferenceScreen>

</PreferenceScreen>
