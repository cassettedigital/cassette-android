<?xml version="1.0" encoding="utf-8"?>
<!-- cassette: one list in play order (iPhone 518ef8b4): UP NEXT *album* in the
     record's colour with shuffle and repeat in its head (orange only while on),
     no history above the song playing, no floating shuffle button, no "clean
     queue". Drag to reorder and swipe to remove stay, Android's own gestures. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cs_bg">

    <com.cappielloantonio.tempo.helper.recyclerview.NestedScrollableHost
        android:id="@+id/player_queue_nested_scrollable_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="@dimen/global_padding_bottom">

                <LinearLayout
                    android:id="@+id/queue_head"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/queue_heading"
                        style="@style/Cassette.Role.Shout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        tools:text="UP NEXT Bon Iver" />

                    <ImageButton
                        android:id="@+id/queue_shuffle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cassette_shuffle"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_lucide_shuffle"
                        app:tint="@color/cs_ink" />

                    <ImageButton
                        android:id="@+id/queue_repeat"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cassette_repeat"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_lucide_repeat"
                        app:tint="@color/cs_ink" />

                    <!-- Keep playing: when the queue runs out, carry on (repeat wins) -->
                    <ImageButton
                        android:id="@+id/queue_keep_playing"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cassette_keep_playing"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_lucide_infinity"
                        app:tint="@color/cs_ink" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/player_queue_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- THEN: what carries on when the queue runs out (iPhone KeepPlayingAlbumCell):
                     one card, its record's cover, name and artist, Swap for the next one the
                     cloud named; a tap plays it now -->
                <TextView
                    android:id="@+id/queue_then"
                    style="@style/Cassette.Role.Shout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/queue_then_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/cs_card"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp"
                    android:visibility="gone">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/queue_then_cover"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/CassetteArtworkRow" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/queue_then_title"
                            style="@style/Cassette.Role.TileLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/queue_then_artist"
                            style="@style/Cassette.Role.Answer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/queue_then_swap"
                        style="@style/Cassette.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/cassette_swap" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.cappielloantonio.tempo.helper.recyclerview.NestedScrollableHost>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
