<?xml version="1.0" encoding="utf-8"?>
<!-- cassette: settings rebuilt to iOS's shape. iOS is a short root of focused
     screens (Account / Playback / App Icon / Storage · Support / About /
     Advanced), each tiny. Android had ~40 controls in one flat scroll across 8
     categories (Transcoding, Replay Gain, Rating, Scrobble, Share, Syncing…),
     almost all Tempo residue or things the account and sensible defaults own.
     What remains: four drill-in screens matching iOS. Removed keys keep working
     from their defaults (e.g. scrobbling stays on) - they are just no longer
     surfaced as controls. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceScreen
        app:key="screen_account"
        app:title="@string/settings_screen_account">

        <!-- Per-app display language. Kept: it overrides the app's UI language
             independent of the phone's system language (Tempo ships several). -->
        <ListPreference
            app:defaultValue="default"
            app:dialogTitle="@string/settings_language"
            app:key="language"
            app:title="@string/settings_language" />

        <Preference
            android:key="account_name"
            app:selectable="false"
            app:title="@string/cassette_account_name" />

        <Preference
            android:key="account_email"
            app:selectable="false"
            app:title="@string/cassette_account_email" />

        <Preference
            android:key="logout"
            android:title="@string/settings_logout_title" />
    </PreferenceScreen>

    <!-- cassette: the root answers on sight (iPhone e080d4c0): your computer and
         its state, what is on this phone, then the values. -->
    <PreferenceCategory
        app:key="cat_computer"
        app:title="@string/cassette_your_computer">

        <Preference
            android:key="computer_row"
            app:title="@string/cassette_your_computer" />

        <Preference
            android:key="resync"
            app:title="@string/cassette_resync" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="cat_phone"
        app:title="@string/cassette_this_phone">

        <Preference
            android:key="phone_music"
            app:selectable="false"
            app:title="@string/cassette_music" />

        <Preference
            android:key="phone_albums"
            app:title="@string/cassette_albums_on_phone" />
    </PreferenceCategory>

    <PreferenceCategory app:key="cat_values">

        <!-- Read-only: the account owns the download tier (it changes every device). -->
        <Preference
            android:key="download_quality_info"
            app:selectable="false"
            app:title="@string/settings_download_quality_title" />

        <Preference
            android:key="equalizer"
            android:title="@string/settings_equalizer_title" />

    <!-- cassette: Appearance, the iPhone's three-way choice. Auto follows the
         phone's light or dark; the choice is this phone's own, never synced. -->
    <ListPreference
        app:defaultValue="default"
        app:entries="@array/theme_list_titles"
        app:entryValues="@array/theme_list_values"
        app:key="theme"
        app:title="@string/cassette_appearance"
        app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:key="cat_support">

        <Preference
            android:key="help"
            app:title="@string/cassette_help" />

        <Preference
            android:key="report_problem"
            app:title="@string/settings_report_problem_title" />

        <!-- cassette: the account's crash-report choice, the iPhone's switch (it follows the
             account to every device; Report a problem is always allowed). -->
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="cassette_diagnostics_consent"
            app:title="@string/cassette_crash_reports" />
    </PreferenceCategory>

    <PreferenceScreen
        app:key="screen_storage"
        app:title="@string/settings_screen_storage">

        <ListPreference
            app:defaultValue="256"
            app:dialogTitle="@string/settings_streaming_cache_size"
            app:entries="@array/streaming_cache_size_titles"
            app:entryValues="@array/streaming_cache_size_values"
            app:key="streaming_cache_size"
            app:title="@string/settings_streaming_cache_size" />

        <Preference
            android:key="streaming_cache_storage"
            app:title="@string/settings_streaming_cache_storage_title" />

        <Preference
            android:key="download_storage"
            app:title="@string/settings_download_storage_title" />

        <Preference
            android:key="delete_download_storage"
            app:summary="@string/settings_delete_download_storage_summary"
            app:title="@string/settings_delete_download_storage_title" />
    </PreferenceScreen>

    <PreferenceScreen
        app:key="screen_about"
        app:title="@string/settings_about_title">

        <Preference
            android:key="version"
            app:title="@string/settings_version_title" />

        <!-- GPL v3: Cassette for Android is built on Tempo; the source is open. -->
        <Preference
            android:key="credit"
            app:summary="@string/cassette_credit_summary"
            app:title="@string/cassette_credit_title" />
    </PreferenceScreen>

</PreferenceScreen>
