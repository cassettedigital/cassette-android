<?xml version="1.0" encoding="utf-8"?>
<!-- cassette: the playlist page in the album's room (iPhone 05fb68d9): its own
     cover (your pick or its preset, never a mosaic of album art) up between back
     and more and lighting the page, a caps title, your own description in the
     serif, "12 SONGS · 74 MIN" counting what is on this phone, PLAY and SHUFFLE
     pills, the songs. No hairlines. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cs_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/playlist_nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/global_padding_bottom">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.cappielloantonio.tempo.ui.view.CoverGlowView
                    android:id="@+id/playlist_glow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/playlist_info_sector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="8dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/playlist_cover_image_view"
                        android:layout_width="@dimen/kit_hero_cover"
                        android:layout_height="@dimen/kit_hero_cover"
                        android:layout_gravity="center_horizontal"
                        android:elevation="14dp"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/CassetteArtworkTile" />

                    <TextView
                        android:id="@+id/playlist_name_label"
                        style="@style/Cassette.Role.PageTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:breakStrategy="balanced"
                        android:maxLines="3"
                        tools:text="CHILLAX" />

                    <TextView
                        android:id="@+id/playlist_description_label"
                        style="@style/Cassette.Role.Answer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="4"
                        android:textSize="@dimen/kit_type_answer_compact"
                        android:visibility="gone"
                        tools:text="Sunday mornings"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/playlist_meta_label"
                        style="@style/Cassette.Role.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        tools:text="9 SONGS · 38 MIN" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/playlist_page_play_button"
                            style="@style/Cassette.Pill.Play"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:text="@string/cassette_play" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/playlist_page_shuffle_button"
                            style="@style/Cassette.Pill.Shuffle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:text="@string/cassette_shuffle" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/song_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingTop="8dp" />

            <include
                android:id="@+id/playlist_empty"
                layout="@layout/view_empty_state" />

            <include
                android:id="@+id/more_like_shelf"
                layout="@layout/view_record_shelf" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/playlist_bar_backdrop"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="top"
        android:alpha="0"
        android:background="@color/cs_bg" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/anim_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:titleTextAppearance="@style/Cassette.Text.BarTitle" />
</FrameLayout>
