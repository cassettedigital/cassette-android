            android:pathData="M29,11.5L29,20.5C29,22.432 27.432,24 25.5,24L6.5,24C4.568,24 3,22.432 3,20.5L3,11.5C3,9.568 4.568,8 6.5,8L25.5,8C27.432,8 29,9.568 29,11.5Z"
            android:fillColor="#00000000"
            android:strokeColor="#E87830"
            android:strokeWidth="2.2"
            android:strokeLineJoin="round"
            android:strokeLineCap="round" />
        <path
            android:pathData="M8.5,16 a3,3 0 1,1 6,0 a3,3 0 1,1 -6,0 Z"
