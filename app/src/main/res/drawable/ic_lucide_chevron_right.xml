<?xml version="1.0" encoding="utf-8"?>
<!-- cassette: the shelf affordance. iOS puts a bold chevron immediately after
     a tappable section title rather than a "See all" link floated right, so
     the header reads as one object you can press. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorOnSurface">
    <path
        android:pathData="M9,6l6,6l-6,6"
        android:strokeWidth="2.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
