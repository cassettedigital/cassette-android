<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- cassette: the kit's colour roles (packages/cassette-kit tokens.json
         color.*.light), the same roles the iPhone and the web read. These are
         the LIGHT paper values; values-night/colors.xml holds the dark ones, so
         every screen follows the phone's light or dark (Settings > Appearance:
         Auto, Light, Dark). Orange (cs_accent) is for live state only: progress,
         what's playing, a switch that is on. Everything pressable is ink. -->
    <color name="cs_sunken">#E9DFCD</color>
    <color name="cs_bg">#F3EADB</color>
    <color name="cs_raised">#F8F1E4</color>
    <color name="cs_elevated">#ECE3D2</color>
    <color name="cs_hairline">#CFC5B4</color>
    <color name="cs_ink">#15110E</color>
    <color name="cs_ink2">#5A4E40</color>
    <color name="cs_ink3">#6B5F51</color>
    <color name="cs_fill">#2E241C</color>
    <color name="cs_on_fill">#F3EADB</color>
    <color name="cs_accent">#CC6A2A</color>
    <color name="cs_accent_text">#A05321</color>
    <color name="cs_danger">#B2462F</color>
    <color name="cs_success">#37745D</color>
    <color name="cs_warning">#836314</color>
    <color name="cs_tint_neutral">#6B5A44</color>
    <color name="cs_tint_neutral_glow">#A17236</color>
    <color name="cs_tint_neutral_text">#7A5A2E</color>
    <color name="cs_glass">#80F3EADB</color>
    <!-- always dark, whatever the phone: the launch lockup -->
    <color name="cs_dark_bg">#1C1914</color>
    <color name="cs_dark_ink">#EDE4D0</color>

    <!-- Tempo's names, kept for the layouts that use them, pointed at the roles. -->
    <color name="titleTextColor">@color/cs_ink</color>
    <color name="subtitleTextColor">@color/cs_ink2</color>
    <color name="dividerColor">@color/cs_hairline</color>
    <color name="lyricsTextColor">@color/cs_ink</color>
    <color name="shadowsLyricsTextColor">@color/cs_hairline</color>
    <color name="searchPlaceholderColor">@color/cs_ink3</color>
    <color name="searchColor">@color/cs_ink</color>


    <color name="gradientTitleColor">#FFFFFF</color>
    <color name="gradientSubtitleColor">#BFBFBF</color>
    <color name="white">#FFFFFF</color>
    <color name="ic_launcher_background">#e87830</color>

    <!-- cassette: cross-device skin accents — derived by scripts/icon/spec.mjs
         skinColors() from the web globals.css dials (accent-9 per skin). The
         account's theme_id rides /api/player/me and picks the matching overlay. -->
    <color name="cs_skin_ink">#1C1913</color>
    <color name="cs_skin_amber_accent">#CC8D00</color>
    <color name="cs_skin_rust_accent">#EC724B</color>
    <color name="cs_skin_marine_accent">#51AF97</color>
    <color name="cs_skin_lime_accent">#8DBE20</color>
    <color name="cs_skin_violet_accent">#A47FFF</color>
    <color name="cs_skin_rose_accent">#E869A4</color>

    <!-- cassette: scrim over the blurred now-playing backdrop — dark enough that
         cream text/controls stay readable over any cover, warm to match the chassis. -->
    <color name="player_backdrop_scrim">#C2120F0C</color>

