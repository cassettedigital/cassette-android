<?xml version="1.0" encoding="utf-8"?>
<!-- cassette: the album page, the iPhone's October room (4081307c, 4b0bbde8,
     400ba1ac). Lit by its own cover: a soft glow that fades out, the 240dp
     cover up between back and more, a big caps title on the left, the artist
     in the serif italic in the record's colour, "1997 · 12 SONGS · 53 MIN",
     PLAY and SHUFFLE pills, tight one-line rows with record-coloured numbers,
     then MORE BY *artist*. Only what is on this phone. No hairlines. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cs_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/fragment_album_page_nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/global_padding_bottom">

            <FrameLayout
                android:id="@+id/album_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.cappielloantonio.tempo.ui.view.CoverGlowView
                    android:id="@+id/album_glow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/album_info_sector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="8dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/album_cover_image_view"
                        android:layout_width="@dimen/kit_hero_cover"
                        android:layout_height="@dimen/kit_hero_cover"
                        android:layout_gravity="center_horizontal"
                        android:elevation="14dp"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/CassetteArtworkTile" />

                    <TextView
                        android:id="@+id/album_name_label"
                        style="@style/Cassette.Role.PageTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:breakStrategy="balanced"
                        android:ellipsize="end"
                        android:maxLines="3"
                        tools:text="IN RAINBOWS" />

                    <TextView
                        android:id="@+id/album_artist_label"
                        style="@style/Cassette.Role.Answer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="?attr/selectableItemBackground"
                        android:ellipsize="end"
                        android:maxLines="2"
                        tools:text="Radiohead" />

                    <TextView
                        android:id="@+id/album_meta_label"
                        style="@style/Cassette.Role.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        tools:text="2007 · 10 SONGS · 42 MIN" />

                    <LinearLayout
                        android:id="@+id/album_page_button_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/album_page_play_button"
                            style="@style/Cassette.Pill.Play"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:text="@string/cassette_play" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/album_page_shuffle_button"
                            style="@style/Cassette.Pill.Shuffle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:text="@string/cassette_shuffle" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/song_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingTop="12dp" />

            <TextView
                android:id="@+id/album_on_phone_line"
                style="@style/Cassette.Role.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp"
                android:textColor="@color/cs_ink3"
                android:visibility="gone"
                tools:text="8 OF 12 SONGS ON THIS PHONE"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/more_by_sector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/more_by_heading"
                    style="@style/Cassette.Role.Shout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingTop="28dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="12dp"
                    tools:text="MORE BY radiohead" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/more_by_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- the bar that fades in once the header scrolls away (BUG-945) -->
    <View
        android:id="@+id/album_bar_backdrop"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="top"
        android:alpha="0"
        android:background="@color/cs_bg" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/anim_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:titleTextAppearance="@style/Cassette.Text.BarTitle" />
</FrameLayout>
