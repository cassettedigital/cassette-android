<?xml version="1.0" encoding="utf-8"?>
<!-- cassette: top bar on the iOS pattern - account chip on the left, the
     screen's own name beside it, and a centred picker for screens that switch
     between collections. The Cassette wordmark used to sit here, set in Inter
     because the brand face is not bundled on Android, so it read as the wrong
     font on every screen. The app does not need to announce its own name each
     time; it needs to say where you are.

     The single FrameLayout matters: a Toolbar lays its direct children out in
     a row, so a centred child added beside a match_parent row got pushed onto
     a second line and doubled the bar's height. Overlaying needs a frame. -->
<com.google.android.material.appbar.AppBarLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/appbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_scrollFlags="scroll|enterAlways|snap"
        app:popupTheme="@style/Cassette.NeutralTintContext">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/toolbar_avatar"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/cs_avatar_circle"
                    android:clickable="true"
                    android:contentDescription="@string/menu_settings_button"
                    android:focusable="true"
                    android:padding="7dp"
                    android:src="@drawable/ic_lucide_user" />

            </LinearLayout>

            <!-- cassette: the screen name is centred, like iOS's nav bar. It
                 shares the centre slot with the picker, so Home reads as a
                 title and Library as a title you can tap. Left-aligned beside
                 the avatar was Material's default, not our design. -->
            <TextView
                android:id="@+id/toolbar_title"
                style="@style/HeadlineSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                tools:text="Home" />

            <TextView
                android:id="@+id/toolbar_picker"
                style="@style/HeadlineSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:visibility="gone"
                app:drawableEndCompat="@drawable/ic_arrow_down"
                tools:text="Albums"
                tools:visibility="visible" />
        </FrameLayout>
    </com.google.android.material.appbar.MaterialToolbar>
</com.google.android.material.appbar.AppBarLayout>
