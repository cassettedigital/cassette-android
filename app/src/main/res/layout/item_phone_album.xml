<?xml version="1.0" encoding="utf-8"?>
<!-- cassette: one record on this phone (iPhone BiggestRow): its cover, its name,
     "artist · n songs", and what it weighs. Tap opens it; long-press removes it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/phone_album_cover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/CassetteArtworkRow" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/phone_album_name"
            style="@style/Cassette.Role.TileLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="17sp"
            tools:text="Dookie" />

        <TextView
            android:id="@+id/phone_album_line"
            style="@style/LabelCardSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Green Day · 14 songs" />
    </LinearLayout>

    <TextView
        android:id="@+id/phone_album_size"
        style="@style/CassetteMono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/cs_ink2"
        android:textSize="@dimen/kit_type_caption"
        tools:text="412 MB" />
</LinearLayout>
