<?xml version="1.0" encoding="utf-8"?>
<!-- cassette: one shelf of records under a page (iPhone DetailShelfBlock): the
     shout heading with its answer in the serif ("MORE LIKE *In Rainbows*"), then
     a row of record tiles, each opening its record or playing it in one tap.
     Hidden until it has records. Used for MORE LIKE on album, artist and
     playlist pages (CassetteShelf). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shelf"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone"
    tools:visibility="visible">

    <TextView
        android:id="@+id/shelf_heading"
        style="@style/Cassette.Role.Shout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        tools:text="MORE LIKE in rainbows" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/shelf_records"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp" />
</LinearLayout>
